/**
 * Sensoren für den Labyrinth-Roboter (Neigung, Farbe, Distanz).
 */
//% color="#D40000" icon="\uf1de" block="Sensoren" weight=95
namespace robotSensors {

    let onTiltCallback: () => void = null;
    let isTiltEventRunning = false;
    let tiltThresholdMg = -260; 

    /**
     * Löst aus, wenn der Roboter um den angegebenen Winkel nach vorne kippt.
     * Geht davon aus, dass der USB-Anschluss nach vorne zeigt (y-Achse wird negativ).
     */
    //% block="wenn Roboter nach vorne kippt (mehr als %grad °)"
    //% grad.min=5 grad.max=60 grad.defl=15
    //% weight=100
    export function wennKipptVorne(grad: number, handler: () => void): void {
        // Umrechnung von Grad in die Beschleunigungskraft (mg) der y-Achse.
        // Formel: sin(Winkel) * 1024 (1G = 1024mg im micro:bit)
        tiltThresholdMg = -(Math.sin(grad * Math.PI / 180) * 1024);
        
        onTiltCallback = handler;

        // Startet die Sensor-Überwachung als Hintergrundprozess, falls noch nicht geschehen
        if (!isTiltEventRunning) {
            isTiltEventRunning = true;
            control.inBackground(function () {
                let warGekippt = false;
                while (true) {
                    let y = input.acceleration(Dimension.Y);
                    
                    // Prüfen, ob der aktuelle Messwert den Schwellenwert unterschreitet
                    let istGekippt = (y < tiltThresholdMg);

                    // Das Ereignis soll nur einmal beim Übergang in die Schieflage auslösen (Flankenauswertung)
                    if (istGekippt && !warGekippt) {
                        if (onTiltCallback) {
                            onTiltCallback();
                        }
                    }
                    
                    warGekippt = istGekippt;
                    basic.pause(50); // Pause zur Entlastung des Prozessors
                }
            });
        }
    }
}
